{ "headers": [
  { "source": "/(.*)\\.(html|css|js|mjs|json)", "headers": [ { "key": "Cache-Control", "value": "public, max-age=0, must-revalidate" } ] },
  { "source": "/", "headers": [ { "key": "Cache-Control", "value": "public, max-age=0, must-revalidate" } ] },
  { "source": "/(.*)\\.(woff2|jpg|png|mp3)", "headers": [ { "key": "Cache-Control", "value": "public, max-age=86400" } ] }
] }
